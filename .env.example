# Copy to .env (or any path, then set ENV_FILE=<path>) and fill in values.
# Never commit the real file.

# Australia Post / StarTrack Shipping & Tracking API (testbed)
AUSPOST_BASE_URL=
AUSPOST_API_KEY=
AUSPOST_PASSWORD=
AUSPOST_ACCOUNT=
STARTRACK_ACCOUNT=
# Optional: product IDs used for price quotes (discovered via scripts/probe_auspost.py)
AUSPOST_PRODUCT_ID=
STARTRACK_PRODUCT_ID=

# TNT (optional bonus, not implemented yet)
TNT_WEBLINK_USERNAME=
TNT_WEBLINK_PASSWORD=
TNT_UAT_USERNAME=
TNT_UAT_PASSWORD=
TNT_ACCOUNT=

# HTTP timeout in seconds for courier calls
COURIER_TIMEOUT_SECONDS=10
